{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {"name": "revision-worker", "namespace": "tmc-revision", "labels": {"app": "tmc-revision-worker"}},
  "spec": {
    "nodeName": "vm-11-0-4-47-debian",
    "hostNetwork": true,
    "dnsPolicy": "Default",
    "restartPolicy": "Never",
    "terminationGracePeriodSeconds": 1,
    "containers": [{
      "name": "worker",
      "image": "docker.io/tide/revision-worker:amd64",
      "imagePullPolicy": "Never",
      "command": ["/worker", "--mode=http", "--listen=127.0.0.1:19280"],
      "env": [{"name": "GOMAXPROCS", "value": "1"}],
      "resources": {"requests": {"cpu": "2", "memory": "512Mi"}, "limits": {"cpu": "2", "memory": "512Mi"}},
      "readinessProbe": {"httpGet": {"host": "127.0.0.1", "path": "/health", "port": 19280}, "periodSeconds": 1}
    }]
  }
}
