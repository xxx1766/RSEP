apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: fig7-inference
  namespace: ${NAMESPACE}
  labels:
    app: issue30-inference
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: fig7-inference
  minReplicas: 1
  maxReplicas: 18
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 60
