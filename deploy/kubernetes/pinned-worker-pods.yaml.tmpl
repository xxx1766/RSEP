apiVersion: v1
kind: List
items:
- apiVersion: v1
  kind: Pod
  metadata:
    name: revision-worker-cloud
    namespace: ${NAMESPACE}
    labels:
      app: revision-worker
      run: pinned-baseline
  spec:
    nodeName: ${CLOUD_NODE}
    hostNetwork: true
    dnsPolicy: Default
    automountServiceAccountToken: false
    restartPolicy: Never
    terminationGracePeriodSeconds: 1
    containers:
    - name: worker
      image: ${WORKER_IMAGE}
      imagePullPolicy: Never
      command: ["/worker", "--mode=http", "--listen=0.0.0.0:29890", "--node=nj1", "--cpu-list=0,1"]
      env:
      - name: GOMAXPROCS
        value: "1"
      ports:
      - name: worker-http
        containerPort: 29890
      resources:
        requests:
          cpu: "2"
          memory: 512Mi
        limits:
          cpu: "2"
          memory: 512Mi
      readinessProbe:
        httpGet:
          host: 127.0.0.1
          path: /health
          port: 29890
        periodSeconds: 1
